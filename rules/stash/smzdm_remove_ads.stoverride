name: "什么值得买去广告"
rules:
  - "DOMAIN,adx-api.zdmimg.com,REJECT"
http:
  mitm:
    - "app-api.smzdm.com"
    - "homepage-api.smzdm.com"
    - "h5.smzdm.com"
    - "haojia-api.smzdm.com"
    - "haojia.m.smzdm.com"
    - "user-api.smzdm.com"
    - "article-api.smzdm.com"
    - "s-api.smzdm.com"
    - "haojia-cdn.smzdm.com"
    - "post.m.smzdm.com"
  url-rewrite:
    - "^https:\\/\\/app-api\\.smzdm\\.com\\/util\\/loading\\? - reject"
    - "^https:\\/\\/app-api\\.smzdm\\.com\\/mychannel\\/list$ - reject"
    - "^https:\\/\\/h5\\.smzdm\\.com\\/user\\/coupon\\/coupon_list\\? - reject"
    - "^https:\\/\\/user-api\\.smzdm\\.com\\/vip\\/bottom_card_list\\? - reject"
    - "^https:\\/\\/article-api\\.smzdm\\.com\\/publish\\/get_bubble\\? - reject"
    - "^https:\\/\\/s-api\\.smzdm\\.com\\/sou\\/search_default_keyword\\? - reject"
    - "^https:\\/\\/s-api\\.smzdm\\.com\\/sou\\/popup_coupon\\? - reject"
  body-rewrite:
    - "^https:\\/\\/app-api\\.smzdm\\.com\\/util\\/update$ response-json-replace data.silence_local_push 0 data.baichuan_redirect_switch 0"
    - "^https:\\/\\/app-api\\.smzdm\\.com\\/util\\/update$ response-json-del data.silence_local_push_msg data.video_cache_num_configs data.haojia_widget data.widget data.operation_float"
    - "^https:\\/\\/app-api\\.smzdm\\.com\\/util\\/update$ response-jq def r: if type==\"object\" then if has(\"ad_campaign_name\") and (.ad_campaign_name|type==\"string\") and (.ad_campaign_name|test(\"\\\\S\")) then empty else . end elif type==\"array\" then map(r) else . end; .data.operation_float |= map(map(r))"
    - "^https:\\/\\/homepage-api\\.smzdm\\.com\\/v3\\/home\\? response-jq .data.component |= map( if (.zz_content | type) == \"array\" then .zz_content |= map( select( ( (.ad_campaign_id? | type == \"string\" and length > 0) // false ) or ( (.tag? | type == \"string\" and length > 0) // false ) or ( (.model_type? == \"ads\" and (type == \"string\")) // false ) | not ) ) else . end ) | .data.component |= map( select(.zz_type == \"circular_banner\" or .zz_type == \"filter\" or .zz_type == \"list\") ) | .data.component |= map( .zz_content |= ( if type == \"array\" then map( if type == \"object\" and (.article_channel_type // \"\") == \"questionnaire\" then empty else . end ) else . end ) ) | del(.data.theme) | .data.component |= map( if .zz_content | type == \"object\" then .zz_content |= del(.circular_banner_option) else . end )"
    - "^https:\\/\\/haojia-api\\.smzdm\\.com\\/home\\/list\\? response-json-del data.header_operation.theme"
    - "^https:\\/\\/haojia-api\\.smzdm\\.com\\/home\\/list\\? response-jq .data.rows |= map(select(.cell_type == \"39001\")) | .data.banner_v2 |= map(select(.cell_type == \"21028\"))"
    - "^https:\\/\\/haojia\\.m\\.smzdm\\.com\\/detail_modul\\/user_related_modul\\? response-json-del data.super_coupon"
    - "^https:\\/\\/haojia\\.m\\.smzdm\\.com\\/detail_modul\\/other_modul\\? response-json-del data.banner"
    - "^https:\\/\\/user-api\\.smzdm\\.com\\/vip$ response-json-del data.activity_entrance_info data.big_banner data.top_banner data.banner_switch data.yaoqingshaiwu data.right_info"
    - "^https:\\/\\/s-api\\.smzdm\\.com\\/sou\\/list_v10\\? response-jq .data.rows |= map(select(.model_type != \"ads\")) | .data.top_aladdin |= map(select(has(\"ad\") | not))"
    - "^https:\\/\\/s-api\\.smzdm\\.com\\/sou\\/filter\\/tags\\/hot_tags\\? response-json-del data.search_faxian data.tonglan data.hongbao"
    - "^https:\\/\\/s-api\\.smzdm\\.com\\/sou\\/filter\\/tags\\/hot_tags\\? response-jq .data.hot_tab |= (if type == \"array\" then map(select(.search_method != \"热点主题榜\")) else . end) | if .data.hot_tab then .data.hot_tab |= map(if .search_method == \"热搜榜搜索热榜\" and .rows then .rows |= map(select(.pos != null and ((.pos | tonumber) != null))) else . end) else . end"
    - "^https:\\/\\/haojia-api\\.smzdm\\.com\\/detail\\/\\d+\\? response-json-del data.quan_log"
    - "^https:\\/\\/haojia-cdn\\.smzdm\\.com\\/preload\\/\\d+\\/fiphone\\/v\\d+_\\d+_\\d+\\/wx\\d+\\/im\\d+\\/[0-9a-z]+\\/[0-9a-z]+\\.json$ response-json-del data.quan_log"
    - "^https:\\/\\/post\\.m\\.smzdm\\.com\\/ajax_app\\/ajax_get_footer_list\\? response-json-del data.tuiguang_ad data.activity_banner"
