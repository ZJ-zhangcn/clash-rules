name: "拼多多去广告"
rules:
  - "AND,((DOMAIN,api.pinduoduo.com),(PROTOCOL,QUIC)),REJECT"
  - "DOMAIN,titan.pinduoduo.com,REJECT"
  - "DOMAIN,xg.pinduoduo.com,REJECT"
  - "DOMAIN,cdl-1.pddpic.com,REJECT"
  - "DOMAIN,cdl-p2.pddpic.com,REJECT"
  - "DOMAIN,cd-1.pddpic.com,REJECT"
  - "DOMAIN,apm.pinduoduo.com,REJECT"
  - "DOMAIN,th-b.pinduoduo.com,REJECT"
  - "DOMAIN,ta.pinduoduo.com,REJECT"
  - "DOMAIN,th.pinduoduo.com,REJECT"
  - "DOMAIN,th-a.pinduoduo.com,REJECT"
  - "DOMAIN,ta-a.pinduoduo.com,REJECT"
  - "DOMAIN,meta.pinduoduo.com,REJECT"
  - "DOMAIN,apm-a.pinduoduo.com,REJECT"
http:
  mitm:
    - "api.pinduoduo.com"
    - "m.pinduoduo.net"
  url-rewrite:
    - "^http:\\/\\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\/d(\\d)? - reject"
    - "^http:\\/\\/\\[[0-9a-fA-F:]+\\]\\/d(\\d)?\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/aristotle\\/unrated_order_for_unreceived_tab\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/aristotle\\/query_order_list_tabs_element\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/aquarius\\/hungary\\/global\\/homepage\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/caterham\\/v3\\/query\\/order_express_group\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/search_hotquery\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/zaire_biz\\/chat\\/resource\\/get_list_data\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/caterham\\/v3\\/query\\/new_chat_group\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/alexa\\/goods\\/back_up\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/caterham\\/v3\\/query\\/personal\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/brand-olay\\/goods_detail\\/bybt_guide\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/engels\\/reviews\\/require\\/append\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/caterham\\/v3\\/query\\/my_order_group\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/caterham\\/v3\\/query\\/likes\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/phantom\\/gbdbpdv\\/extra\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/manufacturer\\/cross\\/shortcut\\/list\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/dunkirk\\/liveactivity\\/push\\/create\\/url\\/report\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/growth\\/nagato\\/app\\/index\\/gather\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/engels\\/wait\\/receive\\/review\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/buffon\\/nasus\\/recommend\\? - reject"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/caterham\\/v2\\/query\\/goods_detail_with_tags\\? - reject"
  body-rewrite:
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/alexa\\/homepage\\/hub\\? response-json-del result.dy_module.irregular_banner_dy result.icon_set result.search_bar_hot_query result.dy_module.irregular_banner_dy"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/alexa\\/homepage\\/hub\\? response-jq .result.bottom_tabs? |= map(select(.link | IN(\"index.html\", \"chat_list.html\", \"personal.html\"))) | .result.buffer_bottom_tabs? |= map(select(.link | IN(\"index.html\", \"chat_list.html\", \"personal.html\"))) | .result.all_top_opts |= map(del(.selected_image, .image, .height, .width))"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/search\\? response-json-del expansion"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/philo\\/personal\\/hub\\? response-json-del monthly_card_entrance personal_center_style_v2_vo icon_set.icons icon_set.top_personal_icons personal_banner"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/oak\\/integration\\/render\\? response-json-del bottom_section_list ui.bottom_section ui.live_section.float_info"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/caterham\\/v3\\/query\\/order_detail_group\\? response-json-del data.goods_list"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/order\\/ response-json-del marketing_banner_vo shipping.banner_above_recommend"
    - "^https:\\/\\/api\\.pinduoduo\\.com\\/api\\/aristotle\\/order_list_v4\\? response-jq .orders |= map(.order_buttons |= map(del(.order_growth_tip)))"
  script:
    - match: "^https:\\/\\/m\\.pinduoduo\\.net\\/mdkd\\/package\\?from_app_scan"
      name: "loon_pinduoduo_remove_ads_01"
      type: "response"
      require-body: true
script-providers:
  "loon_pinduoduo_remove_ads_01":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/PinDuoDuo/PinDuoDuo_remove_ads.js"
    interval: 86400
