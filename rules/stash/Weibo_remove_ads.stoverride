name: "微博去广告"
rules:
  - "DOMAIN-SUFFIX,uve.weibo.com,DIRECT"
  - "DOMAIN,huodong.weibo.cn,REJECT"
  - "DOMAIN-SUFFIX,biz.weibo.com,REJECT"
http:
  mitm:
    - "*.weibo.cn"
    - "*.weibo.com"
    - "weibo.com"
  url-rewrite:
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/(?:ug\\/checkin\\/list|push\\/daily|push\\/info) - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/!\\/live\\/media_homelist\\? - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/comments\\/bullet_screens\\? - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/photo\\/info\\? - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/statuses\\/(?:container_positive|push_info) - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/vote\\/get_vote_detail\\? - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/!\\/chaohua\\/discovery\\/home_bottom\\/switch\\? - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/!\\/huati\\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange) - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/!\\/wbox\\/\\w+\\/(?:home_bottom_modal|interest_category) - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/search\\/(?:container_discover|finder_nav_polling)\\? - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/hot\\/hours_spotlight\\? - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/video\\/redpacket\\? - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/!\\/(?:search\\/finder_nav_polling|sug\\/list\\/finderchange|was\\/finder\\/searchbarchange)\\? - reject"
    - "^https:\\/\\/api\\.weibo\\.cn\\/2\\/video\\/tiny_video_info_show\\? - reject"
    - "^https:\\/\\/bootrealtime\\.uve\\.weibo\\.com\\/v[23]\\/ad\\/realtime - reject"
    - "^https:\\/\\/sdkapp\\.uve\\.weibo\\.com\\/interface\\/sdk\\/(?:get-lbs-cell-info\\.php|sdkconfig\\.php) - reject"
    - "^https:\\/\\/card\\.weibo\\.com\\/article\\/m\\/aj\\/(?:reward|uvead) - reject"
    - "^https:\\/\\/weibo\\.com\\/ttarticle\\/x\\/m\\/aj\\/(?:reward|uvead) - reject"
  script:
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/(?:checkin\\/show|client\\/publisher_list|push\\/active)"
      name: "loon_weibo_remove_ads_01"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/groups\\/allgroups\\/v2\\?"
      name: "loon_weibo_remove_ads_02"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/(?:cardlist|page)"
      name: "loon_weibo_remove_ads_03"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/comments\\/build_comments\\?"
      name: "loon_weibo_remove_ads_04"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/(?:container\\/asyn|flowlist|flowpage)"
      name: "loon_weibo_remove_ads_05"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/friendships\\/(?:create|destroy)"
      name: "loon_weibo_remove_ads_06"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/profile\\/(?:container_timeline|dealatt|me|statuses\\/tab|userinfo)"
      name: "loon_weibo_remove_ads_07"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/shproxy\\/chaohua\\/discovery\\/searchactive\\?"
      name: "loon_weibo_remove_ads_08"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/statuses\\/(?:comments_expand_child|container_detail_comment)"
      name: "loon_weibo_remove_ads_09"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/statuses\\/(?:container_detail\\?|container_timeline(?:_hot|_topic|_topicpage|_unread)?|repost_timeline|unread_hot_timeline)"
      name: "loon_weibo_remove_ads_10"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/statuses\\/(?:extend|show)\\?"
      name: "loon_weibo_remove_ads_11"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/video\\/(?:full_screen_stream|tiny_stream_mid_detail|tiny_stream_video_list)\\?"
      name: "loon_weibo_remove_ads_12"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/!\\/huati\\/discovery_home_bottom_channels\\?"
      name: "loon_weibo_remove_ads_13"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/direct_messages\\/user_list\\?"
      name: "loon_weibo_remove_ads_14"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/messageflow\\/notice\\?"
      name: "loon_weibo_remove_ads_15"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/search\\/(?:container_timeline|finder)\\?"
      name: "loon_weibo_remove_ads_16"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/api\\.weibo\\.cn\\/2\\/searchall\\?"
      name: "loon_weibo_remove_ads_17"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/bootpreload\\.uve\\.weibo\\.com\\/v[12]\\/ad\\/preload"
      name: "loon_weibo_remove_ads_18"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/sdkapp\\.uve\\.weibo\\.com\\/interface\\/sdk\\/sdkad\\.php"
      name: "loon_weibo_remove_ads_19"
      type: "response"
      require-body: true
    - match: "^https:\\/\\/wbapp\\.uve\\.weibo\\.com\\/(?:preload\\/get_ad|wbapplua\\/wbpullad\\.lua)"
      name: "loon_weibo_remove_ads_20"
      type: "response"
      require-body: true
script-providers:
  "loon_weibo_remove_ads_01":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js"
    interval: 86400
